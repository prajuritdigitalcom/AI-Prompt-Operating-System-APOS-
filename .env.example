# GEMINI_API_KEY: Single API Key or Comma-Separated Multiple API Keys
GEMINI_API_KEY="AIzaSy1...,AIzaSy2...,AIzaSy3..."

# GEMINI_API_KEYS: Alternative key for multiple comma-separated keys
GEMINI_API_KEYS="AIzaSy1...,AIzaSy2..."

# Or indexed keys:
# GEMINI_API_KEY_1="AIzaSy1..."
# GEMINI_API_KEY_2="AIzaSy2..."

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
